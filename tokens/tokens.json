{
  "$schema": "https://design-tokens.org",
  "name": "NeetoUI v8",
  "color": {
    "base": { "black": "#0C111D", "white": "#FFFFFF" },
    "gray": { "800": "#101828", "700": "#1D2939", "600": "#344054", "500": "#87929D", "400": "#C2C8CC", "300": "#D8DCDE", "200": "#E9EBED", "100": "#F6F7F8", "50": "#FAFAFA" },
    "primary": { "800": "#006653", "600": "#007A64", "500": "#008068", "100": "#E1F3EE", "50": "#F0F9F7" },
    "accent": { "800": "#095ABA", "600": "#0D66D0", "500": "#1473E6", "100": "#E6F4FF", "50": "#EFF8FF" },
    "success": { "800": "#01795D", "600": "#018D6D", "500": "#02A27C", "100": "#EBFFFA" },
    "error": { "800": "#BB121A", "600": "#C9252D", "500": "#D7373F", "100": "#FEECF0" },
    "warning": { "800": "#BD640D", "600": "#CB6F10", "500": "#DA7B11", "100": "#FBF2E1" },
    "info": { "800": "#095ABA", "600": "#0D66D0", "500": "#1473E6", "100": "#E2F2FF" },
    "pastel": { "silver": "#E8E9ED", "red": "#FFE5E5", "yellow": "#FEF3C5", "green": "#D3F9E8", "blue": "#ECF4FF", "purple": "#EEEBFF", "pink": "#FDE2F1" }
  },
  "typography": {
    "fontFamily": "-apple-system, BlinkMacSystemFont, 'Inter', Arial, 'Segoe UI', Roboto, sans-serif",
    "body": { "size": "14px", "weight": 400, "lineHeight": 1.3, "color": "gray.800" },
    "scale": {
      "h1": { "size": "32px", "weight": 700 }, "h2": { "size": "24px", "weight": 700 },
      "h3": { "size": "20px", "weight": 600 }, "h4": { "size": "16px", "weight": 600 },
      "h5": { "size": "14px", "weight": 600 }, "h6": { "size": "12px", "weight": 600 },
      "body1": { "size": "16px", "weight": 400 }, "body2": { "size": "14px", "weight": 400 },
      "body3": { "size": "12px", "weight": 400 }, "nano": { "size": "10px", "weight": 400 }
    },
    "weights": { "normal": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "lineHeights": { "none": 1, "tight": 1.25, "snug": 1.375, "normal": 1.5, "relaxed": 1.625, "loose": 2 }
  },
  "radius": { "sm": "3px", "default": "5px", "md": "6px", "lg": "8px", "xl": "12px", "full": "999px" },
  "shadow": {
    "xs": "rgba(0,0,0,0.1) 0 2px 1px -1px, rgba(0,0,0,0.07) 0 1px 1px 0, rgba(0,0,0,0.05) 0 1px 3px 0",
    "sm": "rgba(0,0,0,0.2) 0 3px 3px -2px, rgba(0,0,0,0.14) 0 3px 4px 0, rgba(0,0,0,0.12) 0 1px 8px 0",
    "md": "rgba(0,0,0,0.2) 0 3px 5px -1px, rgba(0,0,0,0.14) 0 6px 10px 0, rgba(0,0,0,0.12) 0 1px 18px 0",
    "lg": "rgba(0,0,0,0.2) 0 5px 5px -3px, rgba(0,0,0,0.14) 0 8px 10px 1px, rgba(0,0,0,0.12) 0 3px 14px 2px"
  },
  "motion": { "transition": "all 0.3s linear" },
  "layout": {
    "spacingGrid": "4px",
    "breakpoints": { "mob": "479px", "tab": "768px", "tabLg": "1024px", "desk": "1200px" },
    "heights": { "button": [28, 32, 40], "input": [26, 30, 38], "mainHeader": 80, "subHeader": 37, "tableHeader": 40, "paneHeader": 78, "paneFooter": 80, "paginationBlock": 88 },
    "overlay": { "modalWidths": [320, 480, 720], "paneWidths": ["480px", "50vw"], "backdrop": "#1b1f23dd", "modalZIndex": 99999 }
  }
}
